{
  "manifest_version": 3,
  "minimum_chrome_version": "135",
  "name": "Extensify",
  "version": "0.1.0",
  "description": "A calm home for small, useful browser addons.",
  "icons": {
    "16": "icons/extensify-16.png",
    "32": "icons/extensify-32.png",
    "48": "icons/extensify-48.png",
    "128": "icons/extensify-128.png"
  },
  "action": { "default_popup": "popup.html", "default_title": "Extensify" },
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "permissions": ["storage", "tabs", "userScripts"],
  "host_permissions": ["https://*.supabase.co/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_page": "settings.html"
}
